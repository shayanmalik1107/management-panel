# Groq AI API Key (Required for LAMBA Voice Assistant)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Email OTP SMTP Configuration (For OTP server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="LAMBA Business Support <your_email@gmail.com>"
