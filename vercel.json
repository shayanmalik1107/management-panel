{
  "headers": [
    {
      "source": "/lamba.mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets|downloads|lamba\\.mobileconfig|favicon|lambalogo|manifest).*)",
      "destination": "/index.html"
    }
  ]
}
